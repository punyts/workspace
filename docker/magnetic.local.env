# Settings to try docker/magnetic.compose.yml on one machine (--profile local). No real secrets: the hosted ones come
# from Parameter Store. Compose reads this with --env-file, and the services with MAGNETIC_ENV_FILE.
MAGNETIC_ENV_FILE=magnetic.local.env
MAGNETIC_HOST_NAME=magnetic.localhost
MAGNETIC_RUNTIME_HOST_NAME=run.localhost
MAGNETIC_HTTP_PORT=8080
MAGNETIC_HTTPS_PORT=8443
MAGNETIC_PUBLIC_PORT_SUFFIX=:8443
MAGNETIC_OWNER_DATABASE_URL=postgres://magnetic:magnetic@db:5432/magnetic
MAGNETIC_APP_DATABASE_URL=postgres://magnetic_app:magnetic_app@db:5432/magnetic
MAGNETIC_AGGREGATE_DATABASE_URL=postgres://magnetic_aggregate:magnetic_aggregate@db:5432/magnetic
MAGNETIC_SECRET_KEY=local-compose-secret-change-me
MAGNETIC_EMBEDDING=hash
MAGNETIC_STARTER=none
MAGNETIC_MONTHLY_BUDGET=5
MAGNETIC_DAILY_BUDGET=0.25
