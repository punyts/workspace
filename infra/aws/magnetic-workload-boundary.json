{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WhatMagneticServersMayDo",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability",
        "logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents",
        "ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath",
        "ssmmessages:*", "ec2messages:*", "ssm:UpdateInstanceInformation",
        "secretsmanager:GetSecretValue", "kms:Decrypt",
        "s3:GetObject", "s3:PutObject", "s3:ListBucket",
        "ec2:CreateSnapshot", "ec2:DescribeSnapshots", "ec2:DescribeVolumes", "ec2:CreateTags",
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    }
  ]
}
