{
    "name": "punyts",
    "version": "1.0.0",
    "private": true,
    "description": "The development workspace for the punyts system: each library is its own repo, cloned here by bin/clone-repos.sh",
    "workspaces": [
        "core",
        "expression",
        "state",
        "state-sync",
        "state-react",
        "statenet",
        "stateui",
        "stateui-app",
        "stateui-components",
        "stateui-mcp",
        "example"
    ],
    "overrides": {
        "playwright": "1.61.1",
        "playwright-core": "1.61.1",
        "vitest": "4.1.10",
        "@vitest/browser-playwright": "4.1.10",
        "vite": "8.1.5"
    },
    "scripts": {
        "clone": "bash bin/clone-repos.sh",
        "build": "bash bin/run-all.sh build && npm run build:runtime-bundle -w @punyts/stateui-app",
        "test": "bash bin/run-all.sh test",
        "typecheck": "bash bin/run-all.sh typecheck",
        "status": "bash bin/status.sh"
    }
}
